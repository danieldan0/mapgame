{
  "name": "mapgame",
  "version": "1.0.0",
  "homepage": "https://github.com/danieldan0/mapgame#readme",
  "bugs": {
    "url": "https://github.com/danieldan0/mapgame/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danieldan0/mapgame.git"
  },
  "private": true,
  "workspaces": ["shared", "server", "client"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
